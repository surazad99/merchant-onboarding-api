# Copy to .env via `npm run setup:env` (fills every __GEN_*__ placeholder with random values).
# NEVER commit .env.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=merchant
DB_PASSWORD=__GEN_PASSWORD__
DB_NAME=merchant_apps
DB_RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6379
BULL_PREFIX=bull

JWT_SECRET=__GEN_SECRET__
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# 32 random bytes, hex encoded (64 chars). Used for AES-256-GCM field-level encryption.
FIELD_ENCRYPTION_KEY=__GEN_HEX32__

# Simulated third-party KYB/risk provider
RISK_SIMULATED_FAILURE_RATE=0.2
RISK_MAX_ATTEMPTS=5
RISK_BACKOFF_MS=2000

# Used only by `npm run seed` (local demo users)
SEED_PASSWORD=__GEN_PASSWORD__
